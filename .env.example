# Server Configuration
PROJECT_NAME="Digital Repository of Selected IKS Texts and Resources"
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"
DEBUG=True

# Database Configuration
# Default to SQLite local database file
DATABASE_URL="sqlite:///./iks_repository.db"

# Security & Authentication
# Change in production!
SECRET_KEY="iks-repository-insecure-dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Seed Credentials
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_EMAIL="admin@iks-repository.ac.in"
DEFAULT_ADMIN_PASSWORD="Admin@IKS2026!"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Controlled Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB
